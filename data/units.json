    "ve": {"kind": "silent-e ending", "tip": "English words do not end in v. 've' is one box and the e is silent."},
    "ce": {"kind": "silent-e ending", "tip": "ce says /s/ (c before e is soft). The e is silent, and it makes the i say its name."},
    "ke": {"kind": "silent-e ending", "tip": "ke says /k/. The e is silent, and it makes the a say its name: a-ke."},
